# ===========================================
# ATLAS .gitignore
# ===========================================

# ----- User Configuration -----
atlas.conf
*.local.conf
*.local
# Compose dev-mode override (local copy of docker-compose.override.yml.example)
docker-compose.override.yml

# ----- Development Task Files -----
TASK*.md
FIX_*.md
IMPLEMENT_*.md
ADD_*.md
CREATE_*.md
AUDIT*.md
*AUDIT*.md
FINAL_CLEANUP.md
# Local-only issue tracker (mirrored to GitHub Issues for public tracking).
ISSUES.md
DELETE_BEFORE_PUSH/
/plans/
docs/plans/

# ----- AI/Assistant Related (should not exist) -----
*claude*
*Claude*
.claude/
claude-*/
CLAUDE.md

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.hypothesis/
*.egg-info/
dist/
build/
eggs/
*.egg
.mypy_cache/
.ruff_cache/

# ----- Node.js -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json

# ----- IDE -----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Lens SQLite state left by host/dev runs of versions that kept a pattern
# cache; nothing writes it any more
geometric_state.db
geometric_state.db-wal
geometric_state.db-shm

# ----- Logs -----
*.log
logs/
*_test_run.txt
*_output.txt

# ----- Models (too large for git) -----
*.gguf
*.bin
*.safetensors
*.pt
*.pth

# ----- Data directories -----
data/
projects/

# ----- Secrets -----
*.pem
*.key
*.crt
.env
.env.*
!.env.example
secrets/
*secret*
# The rule above exists to keep credential files out; it must not also
# swallow the scanner that hunts for them.
!tests/infrastructure/test_no_committed_secrets.py

# ----- Temporary files -----
tmp/
temp/
*.tmp
*.bak
*.backup

# ----- Test artifacts -----
.coverage
.coverage.*
coverage.xml
coverage/
*.lcov
junit.xml
test-results/
htmlcov/

# ----- Build artifacts -----
*.tar
*.tar.gz
*.zip

# Binaries
bin/
*.exe
*-darwin-*
*-linux-*

# ----- K3s render output -----
# manifests/ is generated from templates/*.yaml.tmpl by
# scripts/generate-manifests.sh (or install.sh's process_templates step) at
# install time. Source of truth is templates/, not manifests/.
manifests/

# ----- Local data (not for git — user provides their own models) -----
/models/

# ----- Benchmark -----
benchmark/datasets/.cache/
benchmark/results/

# ----- V3 ablation results: COMMITTED (raw traces of the withdrawn V3.0 result, kept for audit) -----
# v3_ablation_results/ is NOT gitignored — it contains per-task pass/fail data
# for all ablation conditions (A-F) needed to verify published numbers.

# ----- Telemetry -----
*.jsonl

# ATLAS workspace (sandbox staging, backups)
.atlas/

# /demo per-run sandbox dirs — kept on disk so you can review what each
# side produced after recording; never checked in.
.demo-raw-*/
.demo-v3-*/

# ----- Go build artifacts -----
proxy/atlas-proxy
tui/atlas-tui

# ----- Geometric Lens large files (on HuggingFace, not in git) -----
geometric-lens/geometric_lens/models/training_embeddings_*.json
geometric-lens/geometric_lens/models/*_backup.pt
geometric-lens/geometric_lens/models/cost_field_phase0.pt
# Keep: cost_field.pt, gx_xgboost.pkl, gx_weights.json,
# gx_thresholds.json, model_identity.json, stats files
# Keep: geometric-lens/data/sample/ (small in-repo sample). The broad
# `data/` rule above would swallow it, so re-include the path chain.
!geometric-lens/data/
geometric-lens/data/*
!geometric-lens/data/sample/

# ----- Runtime artifacts -----
*.pid
nohup.out

_agenttest/

# Lens training corpus left by versions that collected one from agent use;
# nothing writes it any more
lens_training/

# Private diagnostic captures (local, per-machine). The directory itself is
# tracked so the bind mount has the invoking user's ownership on a fresh
# checkout; its contents never are.
diagnostics/*
!diagnostics/.gitkeep
.atlas-upgrade/
geometric-lens/geometric_lens/models/provenance.json
geometric-lens/geometric_lens/models/provenance.json.sig
geometric-lens/geometric_lens/models/.previous-bundle/

# Understand-Anything knowledge graph (local analysis artifact, per-machine)
.ua/
.understand-anything/

# Ablation per-task data (conditions A-D) lives on the HuggingFace dataset
# (benchmarks/v3_ablation/); local downloads must never be re-committed.
# Condition E stays tracked — the discontinued partial run's only copy.
docs/reports/ablation/condition_[a-d]*/v3_lcb/per_task/
docs/reports/ablation/condition_[a-d]*/summary.json
.docs-audit-findings.md
.loop-prompt.md
.loop-progress.md

# Personal Claude Code / aider-desk plugins and the lockfile pinning them.
# Not ATLAS toolchain — nothing in the build, test, or deploy path reads
# these, so a contributor never needs the same set resolved.
.aider-desk/
skills-lock.json

# External-eval / red-teaming workbench: measurement tooling only,
# never part of shipped ATLAS. Promote pieces deliberately or not at all.
redteam/

# Exploratory fuzz targets (red-team hunt, not shipped test surface).
proxy/fuzz_redteam_test.go
proxy/fuzz_redteam2_test.go
proxy/testdata/fuzz/
