{
    "compilerOptions": {
        "module": "Node16",
        "target": "ES2022",
        "lib": [
            "ES2022"
        ],
        "types": [
            "node"
        ],
        "sourceMap": true,
        "strict": true,
        "noEmit": true,
        // vitest's bundled .d.ts references DOM WebSocket types absent from
        // lib ES2022 — skip type-checking declaration files in node_modules.
        "skipLibCheck": true
    },
    "include": [
        "src",
        "test"
    ]
}
