#!/bin/bash
#===========================================
# ATLAS Configuration  —  K3s / KUBERNETES DEPLOYMENT
#===========================================
# This file is read ONLY by ./scripts/install.sh and other K3s tooling
# under scripts/lib/config.sh. It is NOT read by `docker compose`.
#
# If you are running `docker compose up` instead, edit `.env` (see
# `.env.example`) — values placed here will be silently ignored by
# the docker path. See ISSUES.md PC-021.
#
# Copy this file to atlas.conf and customize. Model selection is required;
# hardware/runtime values have sensible defaults.
#
# Usage:
#   cp atlas.conf.example atlas.conf
#   vim atlas.conf  # edit as needed
#   ./scripts/install.sh
#
# May 2026: trimmed from 114 to ~50 vars. The removed entries were
# scaffolding for features that were planned, removed, or never wired
# up (RAG knob injection, Ralph training loop, LoRA model retraining,
# cache manager daemon, JWT auth scheme, V3 phase-component toggles,
# log-level/external-URL placeholders, etc.). Every variable below
# is consumed by at least one of: the install/uninstall scripts, the
# K3s manifest templates, or the benchmark/v3 ablation runner. See
# docs/CONFIGURATION.md §8 for what each one actually controls.
#===========================================

#-------------------------------------------
# Network Configuration
#-------------------------------------------
# Node IP address (set to "auto" to detect, or specify manually)
ATLAS_NODE_IP="auto"

# Kubernetes namespace for all ATLAS services
ATLAS_NAMESPACE="atlas"

# External NodePorts (how you access services from outside the cluster)
ATLAS_PROXY_NODEPORT=30080         # atlas-proxy
ATLAS_LENS_NODEPORT=31144          # geometric-lens
ATLAS_LLAMA_NODEPORT=32735         # llama-server
ATLAS_SANDBOX_NODEPORT=30820       # sandbox executor
ATLAS_V3_NODEPORT=30070            # v3-service (exposed by default; delete the type/nodePort
                                   # lines in templates/atlas-v3-deployment.yaml.tmpl to
                                   # keep it cluster-internal)

# Internal service ports (usually don't change these)
ATLAS_LLAMA_PORT=8080              # llama-server internal (matches docker-compose)
ATLAS_LENS_PORT=8099               # geometric-lens internal (matches Dockerfile EXPOSE)
ATLAS_PROXY_PORT=8090              # atlas-proxy internal (matches docker-compose)
ATLAS_V3_PORT=8070                 # v3-service internal (matches docker-compose)
ATLAS_SANDBOX_PORT=8020            # sandbox internal

#-------------------------------------------
# Storage Paths
#-------------------------------------------
# CHANGE THIS: Where models are stored. Mounted into llama-server at
# /models (read-only) by templates/llama-deployment.yaml.tmpl.
ATLAS_MODELS_DIR="/opt/atlas/models"

# CHANGE THIS: User project workspace. hostPath-mounted at /workspace
# in BOTH atlas-proxy and sandbox pods so file tool calls and run_command
# both see the same files.
ATLAS_PROJECTS_DIR="/opt/atlas/data/projects"

# Parent of the data paths above; uninstall.sh removes it
# when --data is set.
ATLAS_DATA_DIR="/opt/atlas/data"

#-------------------------------------------
# Persistent Volume Sizes
#-------------------------------------------
ATLAS_PVC_PROJECTS_SIZE="20Gi"     # backs lens-projects PVC in the lens deployment

#-------------------------------------------
# Model Configuration
#-------------------------------------------
# Main model filename (required; must exist in ATLAS_MODELS_DIR).
# Pick a registry model with `atlas model recommend`, or provide a BYO GGUF.
ATLAS_MAIN_MODEL="your-model.gguf"

# Draft model for speculative decoding. Speculative decoding is
# DELIBERATELY OFF: no entrypoint passes llama.cpp's draft flags, because
# it measured slower than plain decoding on the reference serving host.
# The knobs are kept so the decision stays visible — do not wire them up
# without an A/B on your own hardware. See docs/CONFIGURATION.md.
ATLAS_DRAFT_MODEL=""

# Context window size (tokens). Size this for the selected model and hardware
# with `atlas tier fit`; larger values increase KV-cache memory.
ATLAS_CONTEXT_LENGTH=16384

# Parallel inference slots. Each slot consumes KV-cache memory; use
# `atlas tier fit` instead of assuming a model-family-specific count.
ATLAS_PARALLEL_SLOTS=1

#-------------------------------------------
# Resource Limits (Kubernetes pod spec)
#-------------------------------------------
# llama-server (the GPU-heavy one)
ATLAS_LLAMA_CPU_REQUEST="2"
ATLAS_LLAMA_CPU_LIMIT="4"
ATLAS_LLAMA_MEMORY_REQUEST="8Gi"
ATLAS_LLAMA_MEMORY_LIMIT="16Gi"

# Other services (lighter weight): atlas-proxy, geometric-lens,
# v3-service, sandbox
ATLAS_SERVICE_CPU_REQUEST="0.5"
ATLAS_SERVICE_CPU_LIMIT="2"
ATLAS_SERVICE_MEMORY_REQUEST="512Mi"
ATLAS_SERVICE_MEMORY_LIMIT="2Gi"

#-------------------------------------------
# Feature Flags
#-------------------------------------------
# Speculative decoding. Deliberately off — see ATLAS_DRAFT_MODEL above.
ATLAS_ENABLE_SPECULATIVE=false

#-------------------------------------------
# Timeouts (seconds)
#-------------------------------------------
# Smoke-test curl against llama-server (scripts/verify-install.sh)
ATLAS_LLM_TIMEOUT=120

# Per-service /health curl timeout (scripts/verify-install.sh)
ATLAS_HEALTH_CHECK_TIMEOUT=10

#-------------------------------------------
# V3 Ablation Knobs (benchmark/v3_runner.py only)
#-------------------------------------------
# These are consumed by benchmark/v3_runner.py for ablation runs.
# The production v3-service reads its own constants from
# benchmark/v3/*.py config dataclasses and does NOT pick these up
# at runtime — they affect ablation behavior only.

# Budget Forcing (1C)
ATLAS_V3_BUDGET_FORCING_DEFAULT_TIER="standard"

# PlanSearch (1A) — number of plans generated per problem
ATLAS_V3_PLAN_SEARCH_NUM_PLANS=3

#-------------------------------------------
# Advanced (usually don't change)
#-------------------------------------------
# Image tag for both the local-build path (scripts/build-containers.sh —
# tags exactly as the K3s manifests reference, ghcr.io/${ATLAS_GHCR_OWNER}/...)
# and the GHCR pull path.
ATLAS_IMAGE_TAG="latest"

# K3s config path (set to "auto" to inherit from $KUBECONFIG)
ATLAS_KUBECONFIG="/etc/rancher/k3s/k3s.yaml"
