{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/itigges22/ATLAS/docs/schemas/error_envelope.schema.json",
  "title": "ATLAS error envelope",
  "description": "Stable error shape. Clients switch on `error` (a closed error-code set); `detail` is a human message that may change.",
  "type": "object",
  "required": [
    "error",
    "detail",
    "api_version"
  ],
  "properties": {
    "error": {
      "type": "string",
      "enum": [
        "unauthorized",
        "invalid_input",
        "unsupported_operation",
        "dependency_unavailable",
        "resource_limit",
        "internal_error"
      ]
    },
    "detail": {
      "type": "string"
    },
    "api_version": {
      "type": "string"
    }
  },
  "additionalProperties": false
}